# サーバーのバージョン。Geyser が対応する版に固定する
# 対応範囲は、起動後に docker compose exec mc rcon-cli "geyser version" で確認できる
MC_VERSION=26.2

# JVM に渡すメモリ。VPS の搭載メモリから 1〜2GB 残して指定する
MC_MEMORY=4G

# RCON のパスワード。openssl rand -base64 24 などで作る
RCON_PASSWORD=change-me-rcon-password

# RCON Web UI のログイン情報
RWA_USERNAME=admin
RWA_PASSWORD=change-me-rwa-password

# サーバー一覧に出る説明文
MOTD=A Minecraft Server

# ゲームの設定
DIFFICULTY=normal
VIEW_DISTANCE=10
MAX_PLAYERS=20

# 公開するポート。既定のままで問題ない
JAVA_PORT=25565
BEDROCK_PORT=19132

# RCON Web UI のポート。localhost にだけ開く
RCON_WEB_PORT=4326
RCON_WEB_WS_PORT=4327

# バックアップの間隔と保持日数
BACKUP_INTERVAL=4h
PRUNE_BACKUPS_DAYS=7
